---
import Button from './Button.astro';
interface Props { text: string; label: string; href: string }
const { text, label, href } = Astro.props;
---
<section class="band" aria-label={label}>
  <div class="wrap">
    <div class="in">
      <p>{text}</p>
      <Button href={href}>{label}</Button>
    </div>
  </div>
</section>
<style>
  .band { padding: 56px 0; }
  .in {
    display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin: 0 auto; padding: 28px 36px;
    background: linear-gradient(90deg, var(--mint-tint), transparent 70%), var(--white); border: 1px solid var(--line); border-radius: 20px;
  }
  p { font-family: var(--font-display); font-size: clamp(19px, 2.1vw, 26px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.25; max-width: 26em; }
  @media (max-width: 640px) { .in { padding: 22px; } .in :global(.btn) { width: 100%; } }
</style>
