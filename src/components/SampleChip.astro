---
// Small outline chip that marks placeholder content.
interface Props { label: string }
---
<span class="chip">{Astro.props.label}</span>
<style>
  .chip {
    display: inline-block; font-family: var(--font-display); font-size: 11.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-2); border: 1px solid var(--rule); border-radius: var(--r-pill); padding: 4px 11px; line-height: 1.2; white-space: nowrap;
  }
</style>
