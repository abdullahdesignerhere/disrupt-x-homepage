---
import Eyebrow from './Eyebrow.astro';
import SampleChip from './SampleChip.astro';
import AnswerCard from './AnswerCard.astro';
interface Props { sampleLabel: string; eyebrow: string; heading: string; items: { question: string; answer: string }[] }
const { sampleLabel, eyebrow, heading, items } = Astro.props;
---
<section class="answers" id="answers" aria-labelledby="answers-h">
  <div class="wrap">
    <div class="top"><Eyebrow>{eyebrow}</Eyebrow><SampleChip label={sampleLabel} /></div>
    <h2 id="answers-h">{heading}</h2>
    <div class="grid">{items.map((a) => <AnswerCard {...a} />)}</div>
  </div>
</section>
<style>
  .answers { padding: 120px 0 40px; }
  .top { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  h2 { font-size: var(--fs-h2); font-weight: 600; margin-top: 16px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 48px; }
  @media (max-width: 980px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } .answers { padding-top: 84px; } }
</style>
