---
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
interface Day { day: string; without: string; withoutIsBad: boolean; with: string }
interface Props {
  days: Day[];
  story: { eyebrow: string; without: string; with: string; dayWord: string; skipLabel: string; skipHref: string; ctaNote: string; ctaLabel: string };
  ctaHref: string;
}
const { days, story, ctaHref } = Astro.props;
---
<div class="daybar" data-daybar style={`--n:${days.length}`}>
  <Eyebrow as="h2" id="story-h">{story.eyebrow}</Eyebrow>
  <div class="daysets">
    {days.map((d, i) => (
      <div class:list={['dayset', { on: i === 0 }]} data-d={i}>
        <div class="dlab"><span>{story.dayWord} </span>{d.day}</div>
        <div class="dls">
          <p class:list={['dline', 'wo', { bad: d.withoutIsBad }]}><b class="tg">{story.without}</b><span>{d.without}</span></p>
          <p class="dline wi"><b class="tg">{story.with}</b><span>{d.with}</span></p>
        </div>
      </div>
    ))}
  </div>
  <div class="dbr">
    <div class="rail4" aria-hidden="true">
      {days.map((d, i) => <div class:list={['st', { on: i === 0 }]}><i></i>{d.day}</div>)}
    </div>
    <div class="dsk">
      <a class="skip" href={story.skipHref} data-skip>{story.skipLabel} <span aria-hidden="true">↓</span></a>
      <div class="dcta" data-dcta>
        <span>{story.ctaNote}</span>
        <Button href={ctaHref} size="sm">{story.ctaLabel}</Button>
      </div>
    </div>
  </div>
</div>
<style>
  .daybar { display: block; text-align: left; margin: 0 auto 28px; max-width: 1320px; }
  .daybar :global(.eyebrow) { margin: 0 0 18px; }
  .dayset { display: flex; gap: 18px 28px; align-items: baseline; flex-wrap: wrap; padding: 12px 0; border-top: 1px solid var(--line); }
  .dlab {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(28px, 2.6vw, 36px); line-height: 1.1;
    letter-spacing: -0.03em; font-variant-numeric: tabular-nums; color: var(--ink); white-space: nowrap;
  }
  .dlab span { color: var(--muted); font-weight: 500; }
  .dls { display: grid; gap: 6px; }
  .dline { display: flex; gap: 12px; align-items: baseline; font-size: 16px; line-height: 1.4; }
  .tg {
    flex: none; font-family: var(--font-display); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase;
    font-weight: 600; border-radius: var(--r-pill); padding: 3px 10px; white-space: nowrap; position: relative; top: -1px;
  }
  .wo { color: var(--muted); }
  .wo .tg { background: rgba(157, 164, 176, 0.16); color: var(--muted); }
  .wo.bad { color: var(--red-tx); }
  .wo.bad .tg { background: rgba(229, 72, 77, 0.16); color: var(--red-tx); }
  .wi { color: var(--ink); font-size: 17px; }
  .wi .tg { background: var(--mint); color: #06110f; }
  .rail4, .skip { display: none; }
  .dcta { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin-top: 14px; font-family: var(--font-display); font-size: 13px; color: var(--ink-2); }
  .st { display: grid; gap: 6px; font-family: var(--font-display); font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .st i { display: block; height: 3px; border-radius: 3px; background: var(--line-2); position: relative; overflow: hidden; }
  .st i::after { content: ''; position: absolute; inset: 0; background: var(--mint); transform-origin: left; transform: scaleX(var(--f, 0)); }
  .st.on { color: var(--ink); }
  .skip { font-family: var(--font-display); font-size: 13px; font-weight: 500; color: var(--muted); text-decoration: none; white-space: nowrap; }
  .skip:hover { color: var(--ink); }

  /* Pinned mode (script adds .js to <html>) */
  :global(.js) .daybar {
    width: min(100%, 1180px); display: grid; grid-template-columns: auto minmax(0, 1fr) 316px; grid-template-rows: auto auto;
    column-gap: 36px; align-items: center; margin: 0 auto 10px; pointer-events: auto; min-height: 74px;
  }
  :global(.js) .daybar :global(.eyebrow) { grid-column: 1; grid-row: 1; margin: 0 0 4px; }
  :global(.js) .daysets, :global(.js) .dayset { display: contents; }
  :global(.js) .dlab { grid-column: 1; grid-row: 2; }
  :global(.js) .dls { grid-column: 2; grid-row: 1 / 3; }
  :global(.js) .dlab, :global(.js) .dls { opacity: 0; visibility: hidden; transition: opacity 0.45s ease, visibility 0.45s; }
  :global(.js) .dayset.on .dlab, :global(.js) .dayset.on .dls { opacity: 1; visibility: visible; transition-delay: 0.12s, 0.12s; }
  :global(.js) .dbr { grid-column: 3; grid-row: 1 / 3; display: grid; gap: 8px; align-content: center; }
  :global(.js) .rail4 { display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: 8px; }
  :global(.js) .dsk { display: grid; min-height: 44px; align-items: center; }
  :global(.js) .skip { display: inline-flex; align-items: center; gap: 6px; grid-area: 1 / 1; min-height: 44px; transition: opacity 0.4s ease; }
  :global(.js) .dcta {
    grid-area: 1 / 1; margin: 0; flex-wrap: nowrap; justify-content: space-between;
    opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 0.5s ease, visibility 0.5s;
  }
  :global(.js) .dcta span { font-size: 11.5px; line-height: 1.25; max-width: 7.5em; }
  :global(.js) .daybar.cta-on .dcta { opacity: 1; visibility: visible; pointer-events: auto; transition-delay: 0.6s; }
  :global(.js) .daybar.cta-on .skip { opacity: 0; pointer-events: none; }

  @media (max-width: 900px) {
    :global(.js) .daybar { grid-template-columns: auto minmax(0, 1fr); grid-template-rows: auto auto auto; column-gap: 14px; min-height: 0; }
    :global(.js) .daybar :global(.eyebrow) { grid-column: 1 / 3; }
    :global(.js) .dlab { grid-column: 1; grid-row: 2; font-size: 30px; }
    :global(.js) .dls { grid-column: 2; grid-row: 2; }
    :global(.js) .dbr { grid-column: 1 / 3; grid-row: 3; grid-template-columns: 1fr auto; align-items: center; gap: 12px; margin-top: 8px; }
    :global(.js) .dcta span { display: none; }
    :global(.js) .dcta { justify-content: flex-end; }
    .dline { font-size: 13.5px; gap: 8px; }
    .wi { font-size: 14.5px; }
    .dayset { padding: 10px 0; }
  }
</style>
