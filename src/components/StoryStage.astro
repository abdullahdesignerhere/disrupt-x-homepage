---
// Hero and story. From 761px up (and tall enough): one pinned stage, the hero text lifts away, the product frame
// rises and flattens, then four days play out. On phones (and short screens) nothing is pinned: the hero is followed by a
// static peek of the product and a stacked timeline of four cards with pre-rendered close-ups (public/assets/story).
// Without JS (or with reduced motion) the wide layout is a normal readable block.
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
import DayBar from './DayBar.astro';
import BrowserFrame from './BrowserFrame.astro';
import { asset } from '../lib/url';
interface Day { day: string; without: string; withoutIsBad: boolean; with: string; target: string; note: string; view: string; closeupAlt: string; closeupHeight: number }
interface Props {
  hero: { eyebrow: string; titleStart: string; titleMark: string; titleEnd: string; lead: string; proof: string };
  story: any;
  cta: { label: string; href: string };
  days: Day[];
}
const { hero, story, cta, days } = Astro.props;
const image = { src: asset('/assets/app-asset.webp'), width: 1440, height: 900, alt: story.frameAlt };
---
<section class="hero story" id="story" aria-labelledby="hero-title" data-story>
  <div class="hero-in" data-hero-in>
    <Eyebrow bar={false}>{hero.eyebrow}</Eyebrow>
    <h1 id="hero-title">{hero.titleStart}<span class="mark">{hero.titleMark}</span>{hero.titleEnd}</h1>
    <p class="what">{hero.lead}</p>
    <Button href={cta.href} size="lg" class="hero-btn">{cta.label}</Button>
    <p class="hero-proof">{hero.proof}</p>
  </div>
  <a class="story-skip" href={story.skipHref}>{story.skipLabel}</a>
  <figure class="peek">
    <img src={image.src} width={image.width} height={image.height} alt={image.alt} decoding="async" />
  </figure>
  <div class="sstage" data-sstage>
    <DayBar days={days} story={story} ctaHref={cta.href} />
    <BrowserFrame image={image} view="asset" chrome={story.frameLabel} caption={story.caption}>
      <div slot="overlay" class="callouts" aria-hidden="true" data-callouts>
        {days.map((d) => (
          <div class="co" data-target={d.target} data-view={d.view}>
            <svg class="cl"><line x1="0" y1="0" x2="0" y2="0"></line></svg>
            <i class="ring"></i>
            <div class="ccard"><b>{story.cardLabel}</b><span>{d.note}</span></div>
          </div>
        ))}
      </div>
    </BrowserFrame>
  </div>
</section>
<section class="sstack" aria-labelledby="stack-h">
  <div class="sk">
    <Eyebrow as="h2" id="stack-h">{story.eyebrow}</Eyebrow>
    <ol class="sk-list">
      {days.map((d, i) => (
        <li class="sk-card" data-reveal>
          <span class="sk-dot" aria-hidden="true"></span>
          <div class="sk-lab"><span>{story.dayWord} </span>{d.day}</div>
          <p class:list={['sk-line', 'wo', { bad: d.withoutIsBad }]}><b class="tg">{story.without}</b><span>{d.without}</span></p>
          <p class="sk-line wi"><b class="tg">{story.with}</b><span>{d.with}</span></p>
          <img
            class="sk-img" src={asset(`/assets/story/day${d.day}.webp`)} width="760" height={d.closeupHeight} alt={d.closeupAlt}
            loading={i === 0 ? 'eager' : 'lazy'} decoding="async"
          />
        </li>
      ))}
    </ol>
    <div class="sk-cta">
      <p>{story.ctaNote}</p>
      <Button href={cta.href} size="lg">{story.ctaLabel}</Button>
    </div>
    <p class="sk-cap">{story.caption}</p>
  </div>
</section>
<style>
  .hero {
    position: relative; padding: 0; text-align: center; overflow: hidden;
    background: radial-gradient(1000px 460px at 50% 0, var(--hero-glow), transparent 72%), var(--paper);
  }
  .hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask: radial-gradient(ellipse 70% 80% at 50% 0, #000, transparent 75%);
    mask: radial-gradient(ellipse 70% 80% at 50% 0, #000, transparent 75%);
  }
  .hero-in { padding: 190px 28px 64px; max-width: 1320px; margin: 0 auto; position: relative; z-index: 1; }
  h1 { font-size: var(--fs-h1); font-weight: 600; margin: 22px auto 28px; max-width: 14em; }
  .what { font-family: var(--font-display); font-size: var(--fs-lead); line-height: 1.45; color: var(--ink-2); max-width: 31em; margin: 0 auto; font-weight: 400; }
  .hero-in :global(.hero-btn), .hero-in > :global(a) { margin-top: 40px; }
  /* Entrance: plain CSS so the headline is painted at once and nothing flashes when scripts load. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in > :global(*) { animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .hero-in > :global(*:nth-child(2)) { animation-delay: 0.08s; }
    .hero-in > :global(*:nth-child(3)) { animation-delay: 0.16s; }
    .hero-in > :global(*:nth-child(4)) { animation-delay: 0.24s; }
    .hero-in > :global(*:nth-child(5)) { animation-delay: 0.32s; }
    @keyframes rise { from { opacity: 0; transform: translateY(30px); } }
  }
  .hero-proof { margin-top: 30px; font-family: var(--font-display); font-size: 14px; color: var(--muted); }
  .sstage { position: relative; max-width: 1380px; margin: 0 auto; padding: 0 28px 80px; }
  .sstage > :global(.frame) { width: var(--bw, 100%); margin-left: auto; margin-right: auto; }

  /* callouts */
  .callouts { position: absolute; inset: 0; pointer-events: none; display: none; }
  :global(.js) .callouts { display: block; }
  .co { position: absolute; inset: 0; visibility: hidden; }
  .co.on { visibility: visible; }
  .ring {
    position: absolute; left: 0; top: 0; width: 0; height: 0; border-radius: 10px; border: 2px solid var(--mint);
    box-shadow: 0 0 0 3px rgba(0, 255, 206, 0.18), 0 0 22px rgba(0, 255, 206, 0.45);
    opacity: 0; transform: scale(0.7); transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .co.on .ring { opacity: 1; transform: none; animation: rpulse 2.6s ease-in-out 0.8s infinite; }
  @keyframes rpulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(0, 255, 206, 0.18), 0 0 22px rgba(0, 255, 206, 0.45); }
    50% { box-shadow: 0 0 0 8px rgba(0, 255, 206, 0.08), 0 0 28px rgba(0, 255, 206, 0.25); }
  }
  .cl { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .cl line { stroke: var(--mint); stroke-width: 1.5; stroke-dasharray: 3 3; opacity: 0; transition: opacity 0.5s ease 0.2s; }
  .co.on .cl line { opacity: 0.9; }
  .ccard {
    position: absolute; left: 0; top: 0; width: 30%; min-width: 190px; max-width: 300px; background: #0b1214; color: #f2f6f5;
    border: 1px solid rgba(0, 255, 206, 0.5); border-radius: 10px; padding: 10px 13px 11px; font-size: 13.5px; line-height: 1.4;
    box-shadow: 0 14px 30px -10px rgba(0, 0, 0, 0.55); opacity: 0; transform: translateY(10px);
    transition: opacity 0.5s ease 0.3s, transform 0.6s ease 0.3s; font-family: var(--font-display); text-align: left;
  }
  .co.on .ccard { opacity: 1; transform: none; }
  .ccard b { display: block; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mint); margin-bottom: 4px; font-weight: 600; }

  /* pinned (JS) mode */
  :global(.js) .hero { height: var(--vh100); min-height: 560px; }
  :global(.js) .hero-in { position: absolute; left: 0; right: 0; top: calc(var(--header-h) + 5vh); padding: 0 28px; }
  :global(.js) .sstage {
    position: absolute; left: 0; right: 0; top: var(--header-h); bottom: 0; padding: 12px 28px 8px;
    display: flex; flex-direction: column; align-items: center; pointer-events: none; z-index: 2;
  }
  :global(.js) .sstage > :global(.frame) { flex: none; }

  /* Stacked story: phones and short screens. The pinned stage is not rendered at all. */
  .sstack, .peek { display: none; }
  .story-skip { display: none; }
  :global(.js) .story-skip {
    display: block; position: fixed; left: 12px; top: calc(var(--header-h) + 10px); z-index: 60;
    transform: translateY(-300%); background: var(--btn-bg); color: var(--btn-tx);
    font: 600 15px var(--font-display); padding: 12px 18px; border-radius: var(--r-pill); text-decoration: none;
  }
  :global(.js) .story-skip:focus { transform: none; }
  .sk { max-width: 560px; margin: 0 auto; padding: 8px 16px 56px; text-align: left; }
  .sk-list { list-style: none; margin: 26px 0 0; padding: 0 0 0 22px; position: relative; display: grid; gap: 34px; }
  .sk-list::before { content: ''; position: absolute; left: 6px; top: 8px; bottom: 8px; width: 2px; background: var(--line-2); border-radius: 2px; }
  .sk-card { position: relative; display: grid; gap: 10px; }
  .sk-dot {
    position: absolute; left: -22px; top: 10px; width: 14px; height: 14px; border-radius: 50%;
    background: var(--mint); box-shadow: 0 0 0 4px var(--paper), 0 0 14px rgba(0, 255, 206, 0.5);
  }
  .sk-lab {
    font-family: var(--font-display); font-weight: 600; font-size: 32px; line-height: 1.1; letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums; color: var(--ink);
  }
  .sk-lab span { color: var(--muted); font-weight: 500; }
  .sk-line { display: flex; gap: 10px; align-items: baseline; margin: 0; font-size: 15.5px; line-height: 1.4; }
  .sk-line.wo { color: var(--muted); }
  .sk-line.wo.bad { color: var(--red-tx); }
  .sk-line.wi { color: var(--ink); font-size: 16.5px; }
  .tg {
    flex: none; font-family: var(--font-display); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase;
    font-weight: 600; border-radius: var(--r-pill); padding: 3px 10px; white-space: nowrap; position: relative; top: -1px;
  }
  .wo .tg { background: rgba(157, 164, 176, 0.16); color: var(--muted); }
  .wo.bad .tg { background: rgba(229, 72, 77, 0.16); color: var(--red-tx); }
  .wi .tg { background: var(--mint); color: #06110f; }
  .sk-img {
    display: block; width: 100%; height: auto; margin-top: 6px; border-radius: 12px; border: 1px solid var(--line-2);
    background: #fff; box-shadow: var(--glow);
  }
  .sk-cta { margin-top: 40px; display: grid; gap: 14px; justify-items: start; font-family: var(--font-display); color: var(--ink-2); }
  .sk-cta p { margin: 0; font-size: 16px; }
  .sk-cap { margin: 26px 0 0; font-size: 12.5px; line-height: 1.5; color: var(--muted); }
  @media (max-width: 760px), (max-height: 520px) {
    .sstage, .story-skip { display: none !important; }
    .sstack { display: block; background: var(--paper); }
    .hero { height: auto !important; min-height: 0 !important; overflow: visible; }
    .hero-in { position: relative !important; top: auto !important; padding: 124px var(--gutter) 28px !important; }
    h1 { font-size: clamp(32px, 9vw, 42px); margin: 18px auto 20px; }
    .what { font-size: 17px; }
    .hero-in :global(.hero-btn), .hero-in > :global(a) { margin-top: 26px; }
    .hero-proof { margin-top: 20px; }
    .peek { display: block; margin: 0 auto; padding: 0 16px 36px; max-width: 560px; position: relative; z-index: 1; }
    .peek img {
      display: block; width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line-2); background: #fff; box-shadow: var(--glow);
    }
  }
  @media (max-width: 900px) {
    .hero-in { padding-top: 150px; }
    :global(.js) .hero-in { top: calc(var(--header-h) + 3vh); }
    :global(.js) .sstage { padding: 8px 16px 6px; }
    .cl { display: none; }
    .ccard { max-width: none; left: 0 !important; right: 0; top: calc(100% + 10px) !important; width: auto; min-width: 0; font-size: 13px; }
    :global(.js) .sstage :global(.stage) { margin-bottom: 86px; }
    h1 { font-size: clamp(34px, 9.4vw, 44px); }
  }
  @media (prefers-reduced-motion: reduce) { .co.on .ring { animation: none; } }
</style>
