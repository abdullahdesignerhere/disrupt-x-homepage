---
import Eyebrow from './Eyebrow.astro';
import SampleChip from './SampleChip.astro';
interface Props {
  sampleLabel: string; eyebrow: string; headline: string; story: string; attribution: string;
  figures: { value: string; label: string }[];
}
const { sampleLabel, eyebrow, headline, story, attribution, figures } = Astro.props;
---
<section class="results" id="results" aria-labelledby="results-h">
  <div class="wrap">
    <div class="top"><Eyebrow>{eyebrow}</Eyebrow><SampleChip label={sampleLabel} /></div>
    <h2 id="results-h">{headline}</h2>
    <ul class="grid">
      {figures.map((f) => (
        <li data-reveal><b>{f.value}</b><span>{f.label}</span></li>
      ))}
    </ul>
    <figure class="quote" data-reveal>
      <span class="qm" aria-hidden="true">“</span>
      <div><blockquote>{story}</blockquote><figcaption>{attribution}</figcaption></div>
    </figure>
  </div>
</section>
<style>
  .results { background: var(--band); padding: 120px 0; position: relative; overflow: hidden; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .results::after {
    content: ''; position: absolute; right: -120px; top: -120px; width: 420px; height: 420px; border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.08); box-shadow: 0 0 0 60px rgba(255, 255, 255, 0.02), 0 0 0 120px rgba(255, 255, 255, 0.015); pointer-events: none;
  }
  .top { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  h2 { font-size: clamp(32px, 4vw, 52px); font-weight: 600; margin-top: 16px; max-width: 15em; }
  .grid { list-style: none; padding: 0; margin: 64px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(255, 255, 255, 0.14); position: relative; }
  .grid li { padding: 34px 28px 0 0; }
  .grid li + li { padding-left: 28px; border-left: 1px solid rgba(255, 255, 255, 0.14); }
  b { display: block; font-family: var(--font-display); font-size: clamp(56px, 6.5vw, 92px); font-weight: 600; letter-spacing: -0.045em; line-height: 1; color: var(--mint); font-variant-numeric: tabular-nums; }
  .grid span { display: block; margin-top: 12px; color: var(--ink-2); font-size: 16px; max-width: 16em; }
  .quote { display: grid; grid-template-columns: auto 1fr; gap: 22px; align-items: start; margin: 64px 0 0; max-width: 820px; position: relative; }
  .qm { font-family: var(--font-display); font-size: 80px; line-height: 0.7; color: var(--mint); }
  blockquote { margin: 0; font-family: var(--font-display); font-size: clamp(20px, 2.2vw, 27px); line-height: 1.4; letter-spacing: -0.01em; }
  figcaption { margin-top: 14px; color: var(--muted); font-size: 14.5px; }
  @media (max-width: 860px) {
    .results { padding: 84px 0; }
    .grid { grid-template-columns: 1fr; }
    .grid li, .grid li + li { padding: 28px 0; border-left: 0; border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  }
</style>
