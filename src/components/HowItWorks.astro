---
import SectionHeading from './SectionHeading.astro';
import Step from './Step.astro';
interface Props { eyebrow: string; heading: string; intro: string; steps: { title: string; text: string; chips: string[] }[] }
const { eyebrow, heading, intro, steps } = Astro.props;
---
<section class="how-sec" id="how" aria-labelledby="how-h">
  <div class="wrap">
    <div class="split">
      <SectionHeading eyebrow={eyebrow} heading={heading} id="how-h" />
      <p class="intro">{intro}</p>
    </div>
    <ol class="how">
      <li class="how-line" aria-hidden="true">
        <svg viewBox="0 0 100 4" preserveAspectRatio="none"><line data-how-line x1="0" y1="2" x2="100" y2="2" stroke="#9da4b0" stroke-width="1.5" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" /></svg>
      </li>
      {steps.map((s, i) => <Step n={i + 1} {...s} accent={i === 1} />)}
    </ol>
  </div>
</section>
<style>
  .how-sec { padding: 120px 0 80px; }
  .split { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 40px; align-items: end; }
  .intro { color: var(--ink-2); font-size: 18px; }
  .how { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin: 64px 0 0; padding: 0; list-style: none; position: relative; }
  .how-line { position: absolute; top: 31px; left: 32px; right: 12%; height: 2px; list-style: none; }
  .how-line svg { width: 100%; height: 4px; display: block; overflow: visible; }
  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; }
    .how { grid-template-columns: 1fr; }
    .how-line { display: none; }
    .how-sec { padding: 84px 0 56px; }
  }
</style>
