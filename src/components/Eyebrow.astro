---
interface Props { as?: 'span' | 'h2' | 'p'; bar?: boolean; id?: string }
const { as: Tag = 'span', bar = true, id } = Astro.props;
---
<Tag class:list={['eyebrow', { 'no-bar': !bar }]} id={id}><slot /></Tag>
<style>
  .eyebrow {
    font-family: var(--font-display);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    line-height: 1.3;
  }
  .eyebrow::before { content: ''; width: 18px; height: 2px; background: var(--accent); }
  .eyebrow.no-bar::before { display: none; }
</style>
